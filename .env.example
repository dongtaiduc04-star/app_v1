# Copy this file to .env and replace every value marked "change-me".
MYSQL_ROOT_PASSWORD=change-me-root-password
AUTH_DB_NAME=authdb
AUTH_DB_USER=getlink_auth
AUTH_DB_PASSWORD=change-me-auth-password
LINK_DB_NAME=linkdb
LINK_DB_USER=getlink_link
LINK_DB_PASSWORD=change-me-link-password

# Must contain at least 32 UTF-8 bytes and be identical for auth/link services.
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes
JWT_ISSUER=getlink_dtd

MYSQL_PORT=3306
GATEWAY_PORT=8080
AUTH_PORT=8081
LINK_PORT=8082
FRONTEND_PORT=3000
